generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContributionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum KnowledgeNodeType {
  CONCEPT
  PERSON
  ORGANISATION
  TECHNOLOGY
  TOPIC
  CONTRIBUTION
  CATEGORY
  TAG
}

enum RelationshipType {
  RELATED_TO
  SUPPORTS
  CONTRADICTS
  DEPENDS_ON
  EXTENDS
  DERIVED_FROM
  BELONGS_TO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  expertProfile ExpertProfile?
  contributions KnowledgeContribution[]
  nodes         KnowledgeNode[]
  relationships KnowledgeRelationship[]
}

model ExpertProfile {
  id                 String             @id @default(uuid())
  field              String
  yearsExperience    Int
  biography          String
  organisation       String?
  location           String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  userId             String             @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  contributions KnowledgeContribution[]
}

model KnowledgeTag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  contributions KnowledgeContributionTag[]
}

model KnowledgeContribution {
  id         String             @id @default(uuid())
  title      String
  topic      String
  experience String
  lesson     String
  status     ContributionStatus @default(DRAFT)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  authorId   String
  categoryId String?

  author        User                       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      KnowledgeCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          KnowledgeContributionTag[]
  nodes         KnowledgeNode[]
  relationships KnowledgeRelationship[]
}

model KnowledgeContributionTag {
  contributionId String
  tagId          String

  contribution KnowledgeContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  tag          KnowledgeTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contributionId, tagId])
}

model KnowledgeNode {
  id             String            @id @default(uuid())
  name           String
  description    String?
  type           KnowledgeNodeType
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  userId         String?
  contributionId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  contribution KnowledgeContribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  outgoingRelationships KnowledgeRelationship[] @relation("SourceNode")
  incomingRelationships KnowledgeRelationship[] @relation("TargetNode")

  @@index([type])
  @@index([name])
  @@index([userId])
}

model KnowledgeRelationship {
  id             String           @id @default(uuid())
  type           RelationshipType
  description    String?
  createdAt      DateTime         @default(now())
  creatorId      String
  contributionId String?
  sourceNodeId   String
  targetNodeId   String

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  contribution KnowledgeContribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  sourceNode KnowledgeNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)

  targetNode KnowledgeNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, type])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([type])
}
